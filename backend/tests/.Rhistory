library(openxlsx)
install.packages("openxlsx")
library(dplyr)
library(purrr)
library(stringr)
library(openxlsx)
parent_dir <- "/home/ttuti/BRIDGE/pipeline_dataset/"  # <-- change this
# Get hospital directories
hospitals <- list.dirs(parent_dir, recursive = FALSE, full.names = TRUE)
results <- map_dfr(hospitals, function(hosp_path) {
hospital <- basename(hosp_path)
# ID folders inside hospital
ids <- list.dirs(hosp_path, recursive = FALSE, full.names = TRUE)
map_dfr(ids, function(id_path) {
id <- basename(id_path)
files <- list.files(id_path, pattern = "\\.pdf$", ignore.case = TRUE)
tibble(
hospital = hospital,
id = id,
ITF = ifelse(any(str_to_upper(files) == "ITF.PDF"), "X", ""),
NAR = ifelse(any(str_to_upper(files) == "NAR.PDF"), "X", ""),
DSC = ifelse(any(str_to_upper(files) == "DSC.PDF"), "X", "")
)
})
})
View(results)
paste0(parent_dir,output_dir)
output_dir <- "hospital_excels"
paste0(parent_dir,output_dir)
output_dir <- "hospital_excels"
dir.create(paste0(parent_dir,output_dir), showWarnings = FALSE)
results |>
group_by(hospital) |>
group_walk(~ {
hospital_name <- .y$hospital
out_file <- file.path(
output_dir,
paste0(hospital_name, "_file_inventory.xlsx")
)
write.xlsx(
.x |> ungroup(),
file = out_file,
overwrite = TRUE
)
})
output_dir <- "hospital_excels"
