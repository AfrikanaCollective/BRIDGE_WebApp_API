dplyr::mutate(
record_id = as.character(record_id),
dplyr::across(infant_ipno_discharge:chp_discharge, as.character)
) |>
tidyr::pivot_longer(
infant_ipno_discharge:chp_discharge,
names_to = "field_name",
values_to = "field_value"
) |>
dplyr::left_join(dsc_fields_bridge, by = "field_name") |>
dplyr::mutate(
field_name = gsub("_discharge", "", field_name, fixed = T)
)
dsc_data_freetext <- dsc_data |>
dplyr::filter(field_type == "text") |>
dplyr::mutate(
field_length = field_name,
field_length = dplyr::recode(field_length, !!!dsc_char_field_length),
field_name = dplyr::recode(field_name, !!!dsc_model_field_map),
)
dsc_data_freetext <- dsc_data_freetext |>
dplyr::mutate(
field_value = ifelse(
stringr::str_detect(field_name, "time"),
gsub(":","", field_value, fixed = T),
field_value
),
field_value = ifelse(
stringr::str_detect(field_name, "date"),
gsub("-","", field_value, fixed = T),
field_value
),
field_value = ifelse(
stringr::str_detect(field_name, "serum_bilirubin"),
gsub(".","", field_value, fixed = T),
field_value
),
field_value = ifelse(
stringr::str_detect(field_name, "hb"),
gsub(".","", field_value, fixed = T),
field_value
),
field_value = ifelse(field_value=="-1", base::strrep("@",times=field_length), field_value),
valid_entry = ifelse(
stringr::str_detect(field_name, "apgar"),
nchar(field_value) > 0 & nchar(field_value) <= field_length,
nchar(field_value)==field_length
)
)|>
dplyr::filter(valid_entry) |>
dplyr::select(-valid_entry)
dsc_field_tree <- dsc_data_freetext |>
dplyr::select(field_name, field_length) |>
unique()
dsc_field_tree_list <- apply(dsc_field_tree, 1, function(x){
#browser()
char_cells <- 1:as.integer(x[2])
field_char_cell <- paste0(x[1], "_", char_cells)
val = data.frame(
field_name = rep(x[1], times=as.integer(x[2])),
field_name_char = field_char_cell
)
return (val)
})
dsc_split_fields <- data.table::rbindlist(dsc_field_tree_list) |>
#dplyr::filter(!(stringr::str_detect(field_name_char, "date")&(stringr::str_detect(field_name_char, "3$")))) |>
#dplyr::filter(!(stringr::str_detect(field_name_char, "date")&(stringr::str_detect(field_name_char, "6$")))) |>
#dplyr::filter(!(stringr::str_detect(field_name_char, "time")&(stringr::str_detect(field_name_char, "3$")))) |>
#dplyr::filter(!(stringr::str_detect(field_name_char, "parity")&(stringr::str_detect(field_name_char, "2$")))) |>
#dplyr::filter(!(stringr::str_detect(field_name_char, "temp")&(stringr::str_detect(field_name_char, "3$")))) |>
dplyr::filter(!(stringr::str_detect(field_name_char, "apgar")&(stringr::str_detect(field_name_char, "2$"))))
dsc_data_freetext_list <- dsc_split_fields |>
dplyr::left_join(dsc_data_freetext, by = "field_name") |>
dplyr::relocate(field_name, .after = hosp_id) |>
dplyr::relocate(field_name_char, .after = field_name) |>
dplyr::arrange(record_id) |>
dplyr::mutate(
field_value_char = ifelse(
stringr::str_detect(field_name, "apgar"),
field_value,
substr(
field_value,
as.integer(stringr::str_extract(field_name_char, "(?<=\\_)\\d+$")),
as.integer(stringr::str_extract(field_name_char, "(?<=\\_)\\d+$"))
)
),
field_type = "character"
) |>
dplyr::select(-field_value, -field_length) |>
dplyr::rename(
c(
value = field_value_char,
roi_type = field_type,
option = field_name_char
)
) |>
dplyr::mutate(
value = ifelse(
stringr::str_detect(field_name, "apgar") & value == "@@","@", value
)
)
#View(itf_data_freetext_list |> dplyr::filter(field_name == "apgar_5m"))
### Checkbox data
dsc_data_radio_tree <- redcap_other_obj$data |>
dplyr::filter(field_type != "descriptive" & required_field == "y")  |>
dplyr::filter(form_name != "a_date_and_place_patient_record") |>
dplyr::filter(field_type != "text") |>
dplyr::filter(stringr::str_detect(form_name, "_discharge")) |>
dplyr::filter(field_name != "clinician_discharge") |>
dplyr::select(field_name, field_type, field_label, select_choices_or_calculations) |>
dplyr::rename(options = select_choices_or_calculations)
dsc_data_radio_tree_list <- apply(dsc_data_radio_tree, 1, function(x){
#browser()
options <- x["options"]
options_list <- unlist(stringr::str_split(options, "\\|"))
options_list <- sapply(options_list, function(y){
z <- stringr::str_trim(unlist(stringr::str_split(y,","))[1])
z <- ifelse(z == "-1", "Empty", z)
return(z)
})
val = data.frame(
field_name = rep(x["field_name"], times=length(options_list)),
field_type = rep(x["field_type"], times=length(options_list)),
field_label = rep(x["field_label"], times=length(options_list)),
options = options_list
)
return (val)
})
dsc_radio_fields <- data.table::rbindlist(dsc_data_radio_tree_list) |>
dplyr::select(field_name, options) |>
dplyr::mutate(
field_name = gsub("_discharge", "", field_name, fixed = T),
options = gsub("Unkn", "Unknown", options, fixed = T),
options = gsub("^Pos$", "Positive", options),
options = gsub("^Neg$", "Negative", options),
options = gsub("^F$", "Female", options),
options = gsub("^M$", "Male", options),
options = gsub("^I$", "Intermediate", options),
options = gsub("^pri$", "Primary", options),
options = gsub("^sec$", "Secondary", options),
field_name = dplyr::recode(field_name, !!!dsc_model_field_map)
)
dsc_data_radio_filler <- dsc_data |>
dplyr::filter(field_type != "text") |>
dplyr::select(record_id, field_name, field_value) |>
dplyr::mutate(
field_value = gsub("Unkn", "Unknown", field_value, fixed = T),
field_value = gsub("^Pos$", "Positive", field_value),
field_value = gsub("^Neg$", "Negative", field_value),
field_value = gsub("^F$", "Female", field_value),
field_value = gsub("^M$", "Male", field_value),
field_value = gsub("^I$", "Intermediate", field_value),
field_value = gsub("^pri$", "Primary", field_value),
field_value = gsub("^sec$", "Secondary", field_value),
field_name = dplyr::recode(field_name, !!!dsc_model_field_map)
)
dsc_data_radio_filled <- dsc_radio_fields |>
dplyr::cross_join(dsc_data_radio_filler$record_id, copy = T) |>
dplyr::rename(record_id = y) |>
unique() |>
dplyr::arrange(record_id, field_name) |>
dplyr::filter(options != "Empty")
dsc_data_radio <- dsc_data |>
dplyr::filter(field_type != "text") |>
dplyr::mutate(
options = field_value,
field_value = ifelse(field_value=="-1", "Empty", field_value),
) |>
dplyr::filter(field_value != "Empty") |>
dplyr::mutate(
field_value = "selected"
) |>
dplyr::mutate(
options = gsub("Unkn", "Unknown", options, fixed = T),
options = gsub("^Pos$", "Positive", options),
options = gsub("^Neg$", "Negative", options),
options = gsub("^F$", "Female", options),
options = gsub("^M$", "Male", options),
options = gsub("^I$", "Intermediate", options),
options = gsub("^pri$", "Primary", options),
options = gsub("^sec$", "Secondary", options),
field_name = dplyr::recode(field_name, !!!dsc_model_field_map)
)
label_data <- dsc_data_radio_tree |>
dplyr::select(field_name, field_label) |>
dplyr::mutate(
field_name = gsub("_discharge", "", field_name, fixed = T),
field_name = dplyr::recode(field_name, !!!dsc_model_field_map)
)
combined_checkbox_data <- dsc_data_radio_filled |>
dplyr::left_join(dsc_data_radio, by = c("record_id", "field_name", "options")) |>
dplyr::mutate(
field_value = ifelse(is.na(field_value), "unselected", field_value),
field_type = "checkbox",
field_option = paste0(field_name, "_", tolower(options))
) |>
dplyr::select(-field_label) |>
dplyr::left_join(label_data, by = "field_name") |>
dplyr::select(-hosp_id) |>
dplyr::left_join(
dsc_data |> dplyr::select(record_id, hosp_id),
by = "record_id"
) |>
unique() |>
dplyr::select(-options) |>
dplyr::rename(
c(
value = field_value,
roi_type = field_type,
option = field_option
)
)
dsc_json_dataset <- dsc_data_freetext_list |>
dplyr::bind_rows(combined_checkbox_data) |>
dplyr::rename(c(variable=field_name, label=field_label))
dsc_json_dataset$hosp_id <- dplyr::recode(
dsc_json_dataset$hosp_id,
!!!level_key
)
write.csv(dsc_json_dataset, "Data/dsc.csv", row.names = F)
dsc_data_freetext |>
dplyr::select(record_id, hosp_id, field_name, field_value) |>
dplyr::filter(!stringr::str_detect(field_value, "!")) |>
write.csv(file="Data/dsc_data_metrics.csv", row.names = F)
